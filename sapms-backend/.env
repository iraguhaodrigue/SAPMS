# Copy this file to .env and fill in your values
# cp .env.example .env

# Server
PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=NewPassword123
DB_NAME=sapms_db

# JWT
JWT_SECRET=sapms2025abrahamnyamasheke_secret_key_x9k2m
